# Required: ImageNet ImageFolder training split (1000 class directories).
IMAGENET_TRAIN=/absolute/path/to/ILSVRC/Data/CLS-LOC/train

# Durable storage. Use identical absolute paths only after shared visibility is
# verified. On isolated servers these are local and may differ. Expect at least
# 100 GiB free per training server.
OUTPUT_ROOT=/absolute/path/to/sit-complementary-a100-runs
ASSET_ROOT=/absolute/path/to/sit-complementary-assets

# Isolated-storage postprocessing (not used during training):
# BUNDLE_DIR=/absolute/path/to/transfer/conv-bundle
# MERGED_OUTPUT_ROOT=/absolute/path/to/sit-complementary-merged-results

# Preferred hardware. This workflow intentionally keeps the original 8-rank
# topology even when the server owns 16 A100 GPUs.
GPU_PROFILE=a100-40gb
# On a standalone 16-GPU host, select one exclusive set of eight first:
# CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# Fixed experiment topology. Do not change for this handoff.
NPROC_PER_NODE=8
GLOBAL_BATCH_SIZE=256
GRADIENT_ACCUMULATION_STEPS=1

# Optional W&B. Export the key in the process environment; never put it here.
WANDB_PROJECT=SiT-Complementary
# WANDB_ENTITY=optional-entity

# Evaluation samples are temporary and deleted after an atomic result is saved.
# Set to 1 only when debugging and sufficient disk is available.
KEEP_FID_SAMPLES=0

# Optional Slurm settings (use only values supported by the target site).
# Select exactly one experiment per coding agent / submission chain:
# EXPERIMENT=conv
# EXPERIMENT=rotation-head
# SLURM_PARTITION=gpu
# SLURM_ACCOUNT=account
# SLURM_QOS=qos
# SLURM_TIME=2-00:00:00
# SLURM_GRES=gpu:a100:8
# Optional only when the owner provides an allowed node name:
# SLURM_NODELIST=a100-node-01

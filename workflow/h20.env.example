# Required: ImageNet ImageFolder training split (1000 class directories).
IMAGENET_TRAIN=/absolute/path/to/ILSVRC/Data/CLS-LOC/train

# Durable storage. Expect at least 100 GiB free for checkpoints and reports.
OUTPUT_ROOT=/absolute/path/to/sit-complementary-h20-runs
ASSET_ROOT=/absolute/path/to/sit-complementary-h20-assets

# Fixed experiment topology. Do not change for this handoff.
NPROC_PER_NODE=8
GLOBAL_BATCH_SIZE=256
GRADIENT_ACCUMULATION_STEPS=1

# Optional W&B. Export the key in the process environment; never put it here.
WANDB_PROJECT=SiT-Complementary
# WANDB_ENTITY=optional-entity

# Evaluation samples are temporary and deleted after an atomic result is saved.
# Set to 1 only when debugging and sufficient disk is available.
KEEP_FID_SAMPLES=0

# Optional Slurm settings (use only values supported by the target site).
# SLURM_PARTITION=gpu
# SLURM_ACCOUNT=account
# SLURM_QOS=qos
# SLURM_TIME=2-00:00:00
# SLURM_GRES=gpu:h20:8
